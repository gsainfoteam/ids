{
  "color": {
    "success":    { "$value": "{green.600}",   "$type": "color" },
    "on-success": { "$value": "{neutral.0}",   "$type": "color" },
    "warning":    { "$value": "{yellow.500}",  "$type": "color" },
    "on-warning": { "$value": "{neutral.950}", "$type": "color" },
    "danger":     { "$value": "{red.700}",     "$type": "color" },
    "on-danger":  { "$value": "{neutral.0}",   "$type": "color" },
    "info":       { "$value": "{sky.700}",     "$type": "color" },
    "on-info":    { "$value": "{neutral.0}",   "$type": "color" }
  }
}
