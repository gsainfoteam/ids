{
  "ids": {
    "color": {
      "values": {
        "$value": [
          "red", "orange", "amber", "yellow", "lime", "green",
          "emerald", "teal", "cyan", "sky", "blue", "indigo",
          "violet", "purple", "fuchsia", "pink", "rose"
        ],
        "$type": "other"
      }
    },
    "mode": {
      "values": { "$value": ["light", "dark"], "$type": "other" }
    },
    "size": {
      "values": { "$value": ["standard", "tiny"], "$type": "other" }
    },
    "variant": {
      "values": { "$value": ["solid", "soft", "outline", "ghost", "glossy"], "$type": "other" }
    }
  }
}
