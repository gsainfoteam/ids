{
  "prefix": ["ids"],
  "placeholders": { "family": "{family}" },
  "collections": { "familyGroup": ["families"] },
  "targets": {
    "css": {
      "manifest": "../css/package.json",
      "names": {
        "identifier": { "case": "kebab", "prefixed": false },
        "customProperty": { "case": "customProperty", "prefixed": true },
        "themeProperty": { "case": "customProperty", "prefixed": false }
      },
      "subSeparator": "--",
      "symbols": {},
      "outputs": { "stylesheet": "dist/ids.css" }
    },
    "ts": {
      "manifest": "../react/package.json",
      "names": {
        "constant": { "case": "constant", "prefixed": true },
        "member": { "case": "camel", "prefixed": false },
        "type": { "case": "pascal", "prefixed": true },
        "key": { "case": "kebab", "prefixed": false }
      },
      "symbols": {
        "colorFamilies": ["color", "families"],
        "familySlots": ["family", "slots"],
        "neutralOnlySlots": ["neutral", "only", "slots"],
        "stateOpacity": ["state", "opacity"],
        "stateFillColor": ["state", "fill", "color"],
        "neutralScales": ["neutral", "scales"],
        "neutralSteps": ["neutral", "steps"],
        "shadows": ["shadows"],
        "componentColors": ["component", "colors"],
        "componentShadows": ["component", "shadows"],
        "paletteModel": ["palette", "model"],
        "statusPalettes": ["status", "palettes"],
        "messageArguments": ["message", "arguments"],
        "defineLocale": ["define", "ids", "locale"]
      },
      "outputs": {
        "foundations": "src/tokens/foundations.json",
        "types": "src/tokens/types.ts",
        "colorRoles": "src/tokens/color-roles.ts",
        "componentTokens": "src/tokens/component-tokens.ts",
        "paletteModel": "src/tokens/palette-model.ts",
        "messages": "src/internal/messages-catalog.ts",
        "editorMessages": "src/components/form/editor/messages-catalog.ts",
        "messageArguments": "src/internal/message-arguments.ts",
        "locales": "src/locales/"
      },
      "modules": { "locale": "src/internal/locale.ts" }
    },
    "dart": {
      "manifest": "../flutter/pubspec.yaml",
      "names": {
        "member": { "case": "camel", "prefixed": false },
        "type": { "case": "pascal", "prefixed": true },
        "key": { "case": "kebab", "prefixed": false }
      },
      "symbols": {
        "mode": ["mode"],
        "colorRoles": ["color", "roles"],
        "families": ["families"],
        "familySlots": ["family", "slots"],
        "neutralOnlySlots": ["neutral", "only", "slots"],
        "allSlots": ["all"],
        "neutralScales": ["neutral", "scales"],
        "neutralSteps": ["neutral", "steps"],
        "slotsOf": ["slots", "of"],
        "stateOpacity": ["state", "opacity"],
        "stateLayer": ["state", "layer"],
        "colors": ["colors"],
        "fromRoles": ["from", "roles"],
        "roles": ["roles"],
        "shadows": ["shadows"],
        "shadowSteps": ["steps"],
        "componentTokens": ["component", "tokens"],
        "componentColorRoles": ["color", "roles"],
        "componentShadowSteps": ["shadow", "steps"],
        "inMode": ["in", "mode"],
        "componentColors": ["component", "colors"],
        "componentShadows": ["component", "shadows"],
        "of": ["of"],
        "tokens": ["tokens"],
        "motion": ["motion"],
        "typography": ["typography"],
        "sans": ["sans"],
        "mono": ["mono"],
        "sansFontFamily": ["sans", "font", "family"],
        "sansFontPackage": ["sans", "font", "package"],
        "monoFontFamily": ["mono", "font", "family"],
        "monoFontFamilyFallback": ["mono", "font", "family", "fallback"],
        "paletteModel": ["palette", "model"],
        "statusPalettes": ["status", "palettes"],
        "messagesBase": ["messages", "base"],
        "language": ["language"],
        "locale": ["locale"],
        "localeMessages": ["messages"],
        "locales": ["values"],
        "sampleArguments": ["sample", "arguments"],
        "messageReaders": ["message", "readers"]
      },
      "outputs": {
        "enums": "lib/tokens/ids_enums.dart",
        "colorRoles": "lib/tokens/ids_color_roles.dart",
        "motion": "lib/tokens/ids_motion.dart",
        "componentTokens": "lib/tokens/ids_component_tokens.dart",
        "typography": "lib/tokens/ids_typography.dart",
        "paletteModel": "lib/tokens/ids_palette_model.dart",
        "messages": "lib/messages/ids_messages.dart",
        "messageReaders": "test/generated/ids_message_readers.dart"
      }
    }
  }
}
