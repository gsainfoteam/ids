{
  "name": "@gsainfoteam/ids-react",
  "version": "0.1.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsainfoteam/ids.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react-hook-form": {
      "types": "./dist/react-hook-form.d.ts",
      "default": "./dist/react-hook-form.js"
    },
    "./tanstack-form": {
      "types": "./dist/tanstack-form.d.ts",
      "default": "./dist/tanstack-form.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "lint": "eslint",
    "format": "prettier --check .",
    "check": "prettier --write . && eslint --fix",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@gsainfoteam/ids-css": "^0.1.1",
    "@tanstack/react-form": "^1.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.62.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "~0.27.20",
    "@heroicons/react": "^2.2.0",
    "@internationalized/date": "^3.12.4",
    "@internationalized/number": "^3.6.8",
    "@tanstack/react-hotkeys": "~0.12.1",
    "cn": "^0.4.0",
    "culori": "^4.0.2",
    "decimal.js": "^10.6.0",
    "es-toolkit": "^1.49.0",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^1.48.0",
    "react-day-picker": "^10.0.1",
    "react-remove-scroll": "^2.7.2",
    "react-textarea-autosize": "^8.5.9",
    "tabbable": "^6.5.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gsainfoteam/ids-css": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@storybook/addon-docs": "10.3.1",
    "@storybook/addon-themes": "10.3.1",
    "@storybook/react-vite": "10.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-form": "^1.33.5",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser-playwright": "^5.0.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "10.3.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.87.0",
    "rollup-preserve-directives": "^1.1.3",
    "storybook": "10.3.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.2",
    "vitest-browser-react": "^2.3.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-form": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    }
  }
}
