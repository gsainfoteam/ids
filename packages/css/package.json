{
  "name": "@gsainfoteam/ids-css",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsainfoteam/ids.git",
    "directory": "packages/css"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "index.css",
    "dist",
    "fonts"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "index.css",
  "exports": {
    ".": "./index.css",
    "./no-fonts.css": "./dist/ids.css"
  },
  "scripts": {
    "build": "pnpm --filter @gsainfoteam/ids-core build && node scripts/copy-fonts.mjs"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "pretendard-gov": "1.3.9"
  }
}
